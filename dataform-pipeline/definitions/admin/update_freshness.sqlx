config {
  type: "operations",
  schema: "admin",
  name: "update_freshness",
  description: "Upserts freshness data per brand after a successful pipeline run. Runs last in the DAG.",
  hasOutput: false,
  tags: ["admin", "freshness"],
  dependencies: [
    "rpt_brand_day",
    "rpt_asin_day",
    "rpt_campaign_day",
    "reporting_freshness_ddl"
  ]
}

-- =============================================================================
-- Freshness Updater
--
-- For each brand, finds the max report_date across the brand rollup,
-- and upserts into admin.reporting_freshness.
-- =============================================================================

MERGE `${dataform.projectConfig.defaultDatabase}.admin.reporting_freshness` T
USING (
  SELECT
    brand_id,
    MAX(report_date) AS data_fresh_through,
    CURRENT_TIMESTAMP() AS last_refresh_at,
    -- TODO: Pass pipeline_run_id from scheduler invocation or generate UUID
    GENERATE_UUID() AS pipeline_run_id,
    'Auto-updated by Dataform pipeline' AS notes
  FROM ${ref("reporting", "rpt_brand_day")}
  WHERE brand_id IS NOT NULL
  GROUP BY brand_id
) S
ON T.brand_id = S.brand_id
WHEN MATCHED THEN
  UPDATE SET
    data_fresh_through = S.data_fresh_through,
    last_refresh_at    = S.last_refresh_at,
    pipeline_run_id    = S.pipeline_run_id,
    notes              = S.notes,
    _loaded_at         = CURRENT_TIMESTAMP()
WHEN NOT MATCHED THEN
  INSERT (brand_id, data_fresh_through, last_refresh_at, pipeline_run_id, notes, _loaded_at)
  VALUES (S.brand_id, S.data_fresh_through, S.last_refresh_at, S.pipeline_run_id, S.notes, CURRENT_TIMESTAMP());
