config {
  type: "view",
  schema: "admin",
  name: "query_history",
  description: "View over BigQuery INFORMATION_SCHEMA.JOBS for pipeline monitoring. Shows last 7 days of Dataform jobs.",
  tags: ["admin", "monitoring"]
}

-- =============================================================================
-- admin.query_history
--
-- Lightweight view for monitoring pipeline execution costs and duration.
-- Note: Requires INFORMATION_SCHEMA access in the project.
-- =============================================================================

SELECT
  job_id,
  creation_time,
  end_time,
  TIMESTAMP_DIFF(end_time, start_time, SECOND) AS duration_seconds,
  total_bytes_processed,
  ROUND(total_bytes_processed / POW(1024, 3), 4) AS gb_processed,
  -- BigQuery on-demand pricing: $6.25/TB (as of 2025)
  ROUND((total_bytes_processed / POW(1024, 4)) * 6.25, 4) AS estimated_cost_usd,
  state,
  error_result.message AS error_message,
  query,
  user_email,
  labels
FROM
  `region-us`.INFORMATION_SCHEMA.JOBS

WHERE
  creation_time >= TIMESTAMP_SUB(CURRENT_TIMESTAMP(), INTERVAL 7 DAY)
  AND job_type = 'QUERY'
  -- Filter to Dataform-related jobs
  AND (
    user_email LIKE '%dataform%'
    OR EXISTS (
      SELECT 1 FROM UNNEST(labels) l WHERE l.key = 'dataform_trigger'
    )
    OR query LIKE '%curated%'
    OR query LIKE '%reporting.rpt_%'
  )

ORDER BY creation_time DESC
