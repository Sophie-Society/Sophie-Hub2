config {
  type: "table",
  schema: "curated",
  name: "bridge_product_client",
  description: "Bridge table linking products to clients. Full refresh.",
  bigquery: {
    clusterBy: ["brand_id"]
  },
  tags: ["dimension", "full_refresh"]
}

-- TODO: Replace with actual raw table ref once confirmed.

SELECT
  SAFE_CAST(product_client_key AS STRING)  AS product_client_key,
  SAFE_CAST(asin_and_product AS STRING)    AS asin_and_product,
  SAFE_CAST(asin_key AS STRING)            AS asin_key,
  SAFE_CAST(client_id AS STRING)           AS brand_id,
  CURRENT_TIMESTAMP()                      AS _loaded_at

FROM
  ${ref("raw", "bridge_product_client_raw")}

WHERE
  product_client_key IS NOT NULL
