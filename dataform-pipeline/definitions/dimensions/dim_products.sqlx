config {
  type: "table",
  schema: "curated",
  name: "dim_products",
  description: "Product dimension table. Source: pbi.pbi_dim_products_unified_latest. Full refresh.",
  bigquery: {
    clusterBy: ["brand_id", "asin"]
  },
  tags: ["dimension", "full_refresh"]
}

-- =============================================================================
-- Source columns (from pbi_dim_products_unified_latest):
--   client_id, asin, parent_asin, product_name, report_start_date
--
-- Dedup: PARTITION BY client_id, asin ORDER BY report_start_date DESC
-- =============================================================================

SELECT
  client_id         AS brand_id,
  asin,
  parent_asin,
  product_name,
  report_start_date,
  CURRENT_TIMESTAMP() AS _loaded_at

FROM
  `sophie-society-reporting.pbi.pbi_dim_products_unified_latest`

WHERE
  asin IS NOT NULL
