config {
  type: "incremental",
  schema: "curated",
  name: "curated_refunds",
  description: "Canonical refunds fact table. Source: pbi.pbi_sellingpartner_refunds_unified_latest.",
  bigquery: {
    partitionBy: "report_date",
    clusterBy: ["brand_id", "marketplace"],
    updatePartitionFilter: "report_date >= DATE_SUB(CURRENT_DATE(), INTERVAL 7 DAY)"
  },
  tags: ["curated", "sales", "incremental"]
}

-- =============================================================================
-- Source columns (from pbi_sellingpartner_refunds_unified_latest):
--   client_id, date, request_time, units_refunded, refund_rate
--
-- Dedup: PARTITION BY client_id, date ORDER BY request_time DESC
-- =============================================================================

SELECT
  client_id                               AS brand_id,
  'US'                                    AS marketplace,
  date                                    AS report_date,

  COALESCE(units_refunded, 0)             AS units_refunded,
  refund_rate,

  request_time,
  CURRENT_TIMESTAMP()                     AS _loaded_at

FROM
  `sophie-society-reporting.pbi.pbi_sellingpartner_refunds_unified_latest`

WHERE
  date IS NOT NULL
  AND client_id IS NOT NULL
  ${when(incremental(), `AND date >= DATE_SUB(CURRENT_DATE(), INTERVAL ${dataform.projectConfig.vars.rolling_window_days} DAY)`)}
