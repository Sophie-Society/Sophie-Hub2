config {
  type: "incremental",
  schema: "curated",
  name: "curated_sns_performance",
  description: "Canonical Subscribe & Save performance fact table. Source: pbi.pbi_sns_performanceweekly_unified_latest.",
  bigquery: {
    partitionBy: "report_date",
    clusterBy: ["brand_id", "marketplace", "asin"],
    updatePartitionFilter: "report_date >= DATE_SUB(CURRENT_DATE(), INTERVAL 30 DAY)"
  },
  tags: ["curated", "sns", "incremental"]
}

-- =============================================================================
-- Source columns (from pbi_sns_performanceweekly_unified_latest):
--   client_name, RequestStartDate, RequestEndDate, sellingPartnerId,
--   marketplaceName, marketplaceId, asin, shippedSubscriptionUnits,
--   activeSubscriptions, totalSubscriptionsRevenue, revenuePenetration,
--   shareOfCouponSubscriptions
--
-- Note: Weekly granularity. RequestStartDate used as report_date.
-- Dedup already applied in per-client view via QUALIFY ROW_NUMBER().
-- =============================================================================

SELECT
  client_name                                     AS brand_id,
  COALESCE(marketplaceName, 'US')                 AS marketplace,
  RequestStartDate                                AS report_date,
  RequestEndDate                                  AS period_end_date,
  asin,
  marketplaceId                                   AS marketplace_id,
  sellingPartnerId                                AS selling_partner_id,

  COALESCE(activeSubscriptions, 0)                AS active_subscriptions,
  COALESCE(shippedSubscriptionUnits, 0)           AS shipped_subscription_units,
  COALESCE(totalSubscriptionsRevenue, 0)          AS total_subscriptions_revenue,
  revenuePenetration                              AS revenue_penetration,
  shareOfCouponSubscriptions                      AS share_of_coupon_subscriptions,

  CURRENT_TIMESTAMP()                             AS _loaded_at

FROM
  `sophie-society-reporting.pbi.pbi_sns_performanceweekly_unified_latest`

WHERE
  RequestStartDate IS NOT NULL
  AND client_name IS NOT NULL
  ${when(incremental(), `AND RequestStartDate >= DATE_SUB(CURRENT_DATE(), INTERVAL ${dataform.projectConfig.vars.rolling_window_days} DAY)`)}
