config {
  type: "incremental",
  schema: "curated",
  name: "curated_match",
  description: "Canonical match-type advertising fact table. Source: pbi.pbi_match_unified_latest.",
  bigquery: {
    partitionBy: "report_date",
    clusterBy: ["brand_id", "marketplace", "campaign_id"],
    updatePartitionFilter: "report_date >= DATE_SUB(CURRENT_DATE(), INTERVAL 7 DAY)"
  },
  tags: ["curated", "advertising", "incremental"]
}

-- =============================================================================
-- Source columns (from pbi_match_unified_latest):
--   client_name, type (SB/SP), date, request_time, campaign_id, campaign_name,
--   asin, match_type (AUTO/EXACT/PHRASE/BROAD), ppc_revenue
--
-- Dedup: PARTITION BY client_name, type, date, campaign_id, asin, match_type
--         ORDER BY request_time DESC
-- =============================================================================

SELECT
  client_name                             AS brand_id,
  'US'                                    AS marketplace,
  date                                    AS report_date,
  CAST(campaign_id AS STRING)             AS campaign_id,
  campaign_name,
  asin,
  type                                    AS ad_type,
  match_type,

  COALESCE(ppc_revenue, 0)                AS ppc_revenue,

  request_time,
  CURRENT_TIMESTAMP()                     AS _loaded_at

FROM
  `sophie-society-reporting.pbi.pbi_match_unified_latest`

WHERE
  date IS NOT NULL
  AND client_name IS NOT NULL
  ${when(incremental(), `AND date >= DATE_SUB(CURRENT_DATE(), INTERVAL ${dataform.projectConfig.vars.rolling_window_days} DAY)`)}
