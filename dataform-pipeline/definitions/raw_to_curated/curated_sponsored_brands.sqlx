config {
  type: "incremental",
  schema: "curated",
  name: "curated_sponsored_brands",
  description: "Canonical Sponsored Brands fact table. Source: pbi.pbi_sb_str_unified_latest.",
  bigquery: {
    partitionBy: "report_date",
    clusterBy: ["brand_id", "marketplace", "campaign_id"],
    updatePartitionFilter: "report_date >= DATE_SUB(CURRENT_DATE(), INTERVAL 7 DAY)"
  },
  tags: ["curated", "advertising", "incremental"]
}

-- =============================================================================
-- Source columns (from pbi_sb_str_unified_latest):
--   client_id, date, request_time, campaign_id, campaign_name, asin,
--   impressions, clicks, ppc_spend, ppc_sales, ppc_orders
--
-- Key differences from SP/SD:
--   - Uses client_id (not client_name)
--   - No ad_id column
--   - No ppc_units column
--   - ASIN extracted from campaign_name via REGEXP_EXTRACT in per-client view
-- =============================================================================

SELECT
  client_id                               AS brand_id,
  'US'                                    AS marketplace,
  date                                    AS report_date,
  CAST(campaign_id AS STRING)             AS campaign_id,
  campaign_name,
  asin,

  COALESCE(impressions, 0)                AS impressions,
  COALESCE(clicks, 0)                     AS clicks,
  COALESCE(ppc_spend, 0)                  AS ppc_spend,
  COALESCE(ppc_sales, 0)                  AS ppc_sales,
  COALESCE(ppc_orders, 0)                 AS ppc_orders,

  SAFE_DIVIDE(ppc_spend, ppc_sales)       AS acos,
  SAFE_DIVIDE(ppc_sales, ppc_spend)       AS roas,
  SAFE_DIVIDE(ppc_spend, clicks)          AS cpc,
  SAFE_DIVIDE(clicks, impressions)        AS ctr,
  SAFE_DIVIDE(ppc_orders, clicks)         AS cvr,

  request_time,
  CURRENT_TIMESTAMP()                     AS _loaded_at

FROM
  `sophie-society-reporting.pbi.pbi_sb_str_unified_latest`

WHERE
  date IS NOT NULL
  AND client_id IS NOT NULL
  ${when(incremental(), `AND date >= DATE_SUB(CURRENT_DATE(), INTERVAL ${dataform.projectConfig.vars.rolling_window_days} DAY)`)}
