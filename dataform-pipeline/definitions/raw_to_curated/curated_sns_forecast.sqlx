config {
  type: "incremental",
  schema: "curated",
  name: "curated_sns_forecast",
  description: "Canonical Subscribe & Save forecast fact table. Source: pbi.pbi_sns_forecast_unified_latest.",
  bigquery: {
    partitionBy: "report_date",
    clusterBy: ["brand_id", "marketplace", "asin"],
    updatePartitionFilter: "report_date >= DATE_SUB(CURRENT_DATE(), INTERVAL 30 DAY)"
  },
  tags: ["curated", "sns", "incremental"]
}

-- =============================================================================
-- Source columns (from pbi_sns_forecast_unified_latest):
--   client_name, snapshot_date, request_end_date, sellingPartnerId,
--   marketplaceName, marketplaceId, asin,
--   next30DayTotalSubscriptionsRevenue, next60Day..., next90Day...,
--   next30DayShippedSubscriptionUnits, next60Day..., next90Day...
--
-- Note: Forecast views currently live in `dev` dataset for some clients.
-- Unified view should be in `pbi` for consistency.
-- =============================================================================

SELECT
  client_name                                     AS brand_id,
  COALESCE(marketplaceName, 'US')                 AS marketplace,
  snapshot_date                                   AS report_date,
  request_end_date,
  asin,
  marketplaceId                                   AS marketplace_id,
  sellingPartnerId                                AS selling_partner_id,

  -- 30-day forecast
  COALESCE(next30DayTotalSubscriptionsRevenue, 0) AS forecast_revenue_30d,
  COALESCE(next30DayShippedSubscriptionUnits, 0)  AS forecast_units_30d,

  -- 60-day forecast
  COALESCE(next60DayTotalSubscriptionsRevenue, 0) AS forecast_revenue_60d,
  COALESCE(next60DayShippedSubscriptionUnits, 0)  AS forecast_units_60d,

  -- 90-day forecast
  COALESCE(next90DayTotalSubscriptionsRevenue, 0) AS forecast_revenue_90d,
  COALESCE(next90DayShippedSubscriptionUnits, 0)  AS forecast_units_90d,

  CURRENT_TIMESTAMP()                             AS _loaded_at

FROM
  `sophie-society-reporting.pbi.pbi_sns_forecast_unified_latest`

WHERE
  snapshot_date IS NOT NULL
  AND client_name IS NOT NULL
  ${when(incremental(), `AND snapshot_date >= DATE_SUB(CURRENT_DATE(), INTERVAL ${dataform.projectConfig.vars.rolling_window_days} DAY)`)}
