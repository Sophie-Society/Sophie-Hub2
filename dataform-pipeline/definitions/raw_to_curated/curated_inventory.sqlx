config {
  type: "incremental",
  schema: "curated",
  name: "curated_inventory",
  description: "Canonical FBA inventory fact table. Source: TBD — no unified inventory view exists yet.",
  bigquery: {
    partitionBy: "report_date",
    clusterBy: ["brand_id", "marketplace", "asin"],
    updatePartitionFilter: "report_date >= DATE_SUB(CURRENT_DATE(), INTERVAL 7 DAY)"
  },
  tags: ["curated", "inventory", "incremental", "TODO"]
}

-- =============================================================================
-- TODO: Inventory does not have per-client views or a unified view yet.
--       The sync config shows bigquery_source as 'TBD'.
--
-- Expected columns from Supabase schema (rpt_inventory):
--   client_name, snapshot_date, asin, sku, fnsku, product_name,
--   available, inv_age_0_to_90_days, ..., units_shipped_t7/30/60/90
--
-- When the unified inventory view is created in pbi dataset, update
-- the FROM clause below and remove the TODO tag.
-- =============================================================================

SELECT
  client_name                             AS brand_id,
  'US'                                    AS marketplace,
  snapshot_date                           AS report_date,
  asin,
  sku,
  fnsku,
  product_name,
  product_client_key,

  COALESCE(available, 0)                  AS available,
  COALESCE(inv_age_0_to_90_days, 0)      AS inv_age_0_to_90,
  COALESCE(inv_age_91_to_180_days, 0)    AS inv_age_91_to_180,
  COALESCE(inv_age_181_to_270_days, 0)   AS inv_age_181_to_270,
  COALESCE(inv_age_271_to_365_days, 0)   AS inv_age_271_to_365,
  COALESCE(inv_age_365_plus_days, 0)     AS inv_age_365_plus,
  COALESCE(units_shipped_t7, 0)          AS units_shipped_t7,
  COALESCE(units_shipped_t30, 0)         AS units_shipped_t30,
  COALESCE(units_shipped_t60, 0)         AS units_shipped_t60,
  COALESCE(units_shipped_t90, 0)         AS units_shipped_t90,

  CURRENT_TIMESTAMP()                     AS _loaded_at

FROM
  -- TODO: Replace with actual unified inventory view once created
  `sophie-society-reporting.pbi.pbi_inventory_unified_latest`

WHERE
  snapshot_date IS NOT NULL
  AND client_name IS NOT NULL
  ${when(incremental(), `AND snapshot_date >= DATE_SUB(CURRENT_DATE(), INTERVAL ${dataform.projectConfig.vars.rolling_window_days} DAY)`)}
