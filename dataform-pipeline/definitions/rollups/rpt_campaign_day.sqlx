config {
  type: "incremental",
  schema: "reporting",
  name: "rpt_campaign_day",
  description: "Daily campaign-level rollup combining all ad types. Rebuilds trailing N days.",
  bigquery: {
    partitionBy: "report_date",
    clusterBy: ["brand_id", "campaign_id", "marketplace"],
    updatePartitionFilter: "report_date >= DATE_SUB(CURRENT_DATE(), INTERVAL 7 DAY)"
  },
  tags: ["rollup", "reporting", "incremental"],
  dependencies: [
    "curated_sponsored_products",
    "curated_sponsored_display",
    "curated_sponsored_brands",
    "dim_clients"
  ]
}

-- =============================================================================
-- rpt_campaign_day: One row per brand × campaign × marketplace × date
--
-- Note: SB has no ppc_units column; we use 0.
-- =============================================================================

WITH ads AS (
  -- SP: has ppc_units
  SELECT brand_id, marketplace, report_date, campaign_id, campaign_name, campaign_type, ad_type,
         impressions, clicks, ppc_spend, ppc_sales, ppc_orders, ppc_units
  FROM ${ref("curated_sponsored_products")}
  WHERE campaign_id IS NOT NULL
    ${when(incremental(), `AND report_date >= DATE_SUB(CURRENT_DATE(), INTERVAL ${dataform.projectConfig.vars.rolling_window_days} DAY)`)}

  UNION ALL

  -- SD: has ppc_units
  SELECT brand_id, marketplace, report_date, campaign_id, campaign_name, campaign_type, ad_type,
         impressions, clicks, ppc_spend, ppc_sales, ppc_orders, ppc_units
  FROM ${ref("curated_sponsored_display")}
  WHERE campaign_id IS NOT NULL
    ${when(incremental(), `AND report_date >= DATE_SUB(CURRENT_DATE(), INTERVAL ${dataform.projectConfig.vars.rolling_window_days} DAY)`)}

  UNION ALL

  -- SB: no ppc_units, use 0
  SELECT brand_id, marketplace, report_date, campaign_id, campaign_name, campaign_type, ad_type,
         impressions, clicks, ppc_spend, ppc_sales, ppc_orders, 0 AS ppc_units
  FROM ${ref("curated_sponsored_brands")}
  WHERE campaign_id IS NOT NULL
    ${when(incremental(), `AND report_date >= DATE_SUB(CURRENT_DATE(), INTERVAL ${dataform.projectConfig.vars.rolling_window_days} DAY)`)}
)

SELECT
  brand_id,
  marketplace,
  report_date,
  campaign_id,
  -- Use ANY_VALUE for string columns that are the same per campaign_id
  ANY_VALUE(campaign_name)  AS campaign_name,
  ANY_VALUE(campaign_type)  AS campaign_type,
  ANY_VALUE(ad_type)        AS ad_type,

  -- Metrics
  SUM(impressions)  AS total_impressions,
  SUM(clicks)       AS total_clicks,
  SUM(ppc_spend)    AS total_ppc_spend,
  SUM(ppc_sales)    AS total_ppc_sales,
  SUM(ppc_orders)   AS total_ppc_orders,
  SUM(ppc_units)    AS total_ppc_units,

  -- Computed
  SAFE_DIVIDE(SUM(ppc_spend), SUM(ppc_sales))     AS acos,
  SAFE_DIVIDE(SUM(ppc_sales), SUM(ppc_spend))     AS roas,
  SAFE_DIVIDE(SUM(ppc_spend), SUM(clicks))        AS cpc,
  SAFE_DIVIDE(SUM(clicks), SUM(impressions))       AS ctr,
  SAFE_DIVIDE(SUM(ppc_orders), SUM(clicks))        AS cvr,

  -- Dimension enrichment
  d.brand_name,
  d.pod,

  CURRENT_TIMESTAMP() AS _loaded_at

FROM ads
LEFT JOIN ${ref("dim_clients")} d
  ON ads.brand_id = d.brand_id
GROUP BY brand_id, marketplace, report_date, campaign_id,
         d.brand_name, d.pod
