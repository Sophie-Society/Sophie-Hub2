config {
  type: "assertion",
  schema: "dataform_assertions",
  name: "assert_not_null_report_date",
  description: "report_date must never be NULL in rollup tables",
  tags: ["assertion", "data_quality"]
}

SELECT 'rpt_brand_day' AS table_name, brand_id, report_date
FROM ${ref("reporting", "rpt_brand_day")}
WHERE report_date IS NULL

UNION ALL

SELECT 'rpt_asin_day' AS table_name, brand_id, report_date
FROM ${ref("reporting", "rpt_asin_day")}
WHERE report_date IS NULL

UNION ALL

SELECT 'rpt_campaign_day' AS table_name, brand_id, report_date
FROM ${ref("reporting", "rpt_campaign_day")}
WHERE report_date IS NULL
